<Window x:Class="WinLinScp.Views.UploadConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上传确认" SizeToContent="WidthAndHeight" Width="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="TxtSummary" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="TxtDestination" Foreground="#0078D4" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <GroupBox Header="打包方式" Padding="8,6" Margin="0,0,0,4">
            <StackPanel>
                <RadioButton x:Name="RadioNone" Content="不打包 —— 逐个文件传输" Margin="0,2"/>
                <RadioButton x:Name="RadioTar" Content="tar 打包（推荐）—— 单个归档一次传输" IsChecked="True" Margin="0,2"/>
                <RadioButton x:Name="RadioZip" Content="zip 打包 —— 单个归档一次传输（压缩更小）" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="打包上传会在远端目标目录自动解压，并清理临时归档。" FontSize="11"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="上传" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
