<Window x:Class="WinLinScp.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 WinLinScp" SizeToContent="WidthAndHeight" Width="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/WinLinScp;component/Assets/WinLinScp.png" Width="56" Height="56" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WinLinScp" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="VerText" Foreground="Gray" FontSize="12"/>
                <TextBlock Text="作者：Mcd0_LUO" Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="轻量级 WinSCP 风格 Windows ↔ Linux 文件管理器" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="复用系统 OpenSSH：支持 ~/.ssh/config 别名（密钥 / 跳板 ProxyJump）、登录脚本、IP + 密码直接连接。" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>
        <TextBlock Text="传输带实时速度、乐观进度与预计剩余时间（ETA）；任务队列可拖高、可收起；支持 tar/zip 打包上传，多选一次拖入。" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
