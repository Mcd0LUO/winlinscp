<Window x:Class="WinLinScp.Views.RemoteViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看远端文件" Height="520" Width="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="White">
            <Button Content="重新加载" Command="{Binding ReloadCommand}"/>
            <Button Content="用默认程序打开" Command="{Binding OpenWithDefaultAppCommand}"/>
            <Button Content="保存到本地…" Command="{Binding SaveToLocalCommand}"/>
            <Separator/>
            <TextBlock Text="编码:" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <ComboBox Width="120" ItemsSource="{Binding Encodings}" SelectedItem="{Binding EncodingName}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#666666"/>
        </ToolBar>

        <TextBox Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Padding="8" Background="White"/>
    </DockPanel>
</Window>
