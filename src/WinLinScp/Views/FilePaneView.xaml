<UserControl x:Class="WinLinScp.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinLinScp.ViewModels"
             xmlns:views="clr-namespace:WinLinScp.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel KeyDown="Pane_KeyDown">
        <!-- 路径栏 -->
        <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource NavButton}" Content="&#xE72B;"
                    ToolTip="后退 (Alt+←)" Command="{Binding GoBackCommand}"/>
            <Button Grid.Column="1" Style="{StaticResource NavButton}" Content="&#xE72A;"
                    ToolTip="前进 (Alt+→)" Command="{Binding GoForwardCommand}"/>
            <Button Grid.Column="2" Style="{StaticResource NavButton}" Content="&#xE74A;"
                    ToolTip="上级目录 (Backspace)" Command="{Binding GoUpCommand}"/>
            <Button Grid.Column="3" Style="{StaticResource NavButton}" Content="&#xE72C;"
                    ToolTip="刷新 (F5)" Command="{Binding RefreshCommand}"/>

            <DockPanel Grid.Column="4" Height="30">
                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                        Content="&#xE81C;" ToolTip="历史 / 盘符" Click="HistoryButton_Click" Margin="4,0,0,0"/>
                <Button x:Name="EditPathButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                        Content="&#xE70F;" ToolTip="编辑路径" Click="EditPathButton_Click"/>
                <Grid>
                    <!-- 面包屑：可点击跳转 + 可拖放目标 -->
                    <ScrollViewer x:Name="BreadcrumbHost" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" AllowDrop="True"
                                      DragOver="Breadcrumb_DragOver" DragLeave="Breadcrumb_DragLeave"
                                      Drop="Breadcrumb_Drop">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Foreground="#999999" VerticalAlignment="Center" Margin="2,0"
                                                   Visibility="{Binding ShowChevron, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{Binding Text}" Padding="5,1" Margin="1,0" Cursor="Hand"
                                                Click="Breadcrumb_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="#333333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 编辑模式：手动输入路径 -->
                    <TextBox x:Name="PathEdit" Visibility="Collapsed" Padding="3" VerticalContentAlignment="Center"
                             KeyDown="PathEdit_KeyDown" LostFocus="PathEdit_LostFocus"/>
                </Grid>
            </DockPanel>

            <ProgressBar Grid.Column="5" Width="60" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"
                         IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- 文件列表 + 加载/空目录占位 -->
        <Grid>
            <ListView x:Name="EntryList"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Extended"
                  SelectionChanged="EntryList_SelectionChanged"
                  MouseDoubleClick="EntryList_MouseDoubleClick"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  BorderThickness="1,0,0,0"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="EntryList_PreviewMouseMove"
                  DragOver="EntryList_DragOver"
                  Drop="EntryList_Drop">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开" Command="{Binding OpenCommand}"/>
                    <Separator/>
                    <MenuItem Header="下载" Command="{Binding DownloadCommand}"
                              Visibility="{Binding SupportsDownload, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="上传" Command="{Binding UploadCommand}"
                              Visibility="{Binding SupportsUpload, Converter={StaticResource BoolToVis}}"/>
                    <Separator Visibility="{Binding SupportsArchive, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="压缩为 .tar.gz" Command="{Binding CompressTarGzCommand}"
                              Visibility="{Binding SupportsTarGz, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="压缩为 .zip" Command="{Binding CompressZipCommand}"
                              Visibility="{Binding SupportsArchive, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="解压到当前目录" Command="{Binding ExtractCommand}"
                              IsEnabled="{Binding CanExtractSelected}"
                              Visibility="{Binding SupportsArchive, Converter={StaticResource BoolToVis}}"/>
                    <Separator/>
                    <MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}"/>
                    <MenuItem Header="新建文件" Command="{Binding NewFileCommand}"/>
                    <MenuItem Header="重命名 (F2)" Command="{Binding RenameCommand}"/>
                    <MenuItem Header="删除 (Del)" Command="{Binding DeleteCommand}"/>
                    <Separator/>
                    <MenuItem Header="执行自定义脚本…" Command="{Binding RunCustomScriptCommand}"
                              ToolTip="本地=PowerShell，远端=bash（工作目录=当前目录）"/>
                    <Separator Visibility="{Binding SupportsShellTools, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="以终端打开" Command="{Binding OpenTerminalCommand}"
                              ToolTip="在所选文件夹（或当前目录）打开终端"
                              Visibility="{Binding SupportsShellTools, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="以任务管理器打开" Command="{Binding OpenTaskManagerCommand}"
                              Visibility="{Binding SupportsShellTools, Converter={StaticResource BoolToVis}}"/>
                    <Separator/>
                    <MenuItem Header="刷新 (F5)" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <Grid Width="16" Height="16" Margin="0,0,6,0">
                                        <!-- 字形先显示，shell 图标异步加载后覆盖 -->
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding IconGlyph}"
                                                   Foreground="{Binding IconBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Width="16" Height="16" views:IconLoader.IconPath="{Binding}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding KindText}"/>
                    <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="修改时间" Width="120" DisplayMemberBinding="{Binding ModifiedText}"/>
                </GridView>
            </ListView.View>
        </ListView>
            <TextBlock Text="正在加载…" FontSize="13" Foreground="#999999"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="（空目录）" FontSize="13" Foreground="#999999"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DockPanel>
</UserControl>
