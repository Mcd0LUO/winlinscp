<Window x:Class="WinLinScp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinLinScp.Views"
        Title="WinLinScp - Windows ↔ Linux 文件管理" Height="640" Width="1200"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="连接…" Command="{Binding ConnectCommand}"/>
                <Button Content="断开" Command="{Binding DisconnectCommand}" IsEnabled="{Binding RemotePane.IsConnected}"/>
                <Separator/>
                <Button Content="↓ 下载" Command="{Binding RemotePane.DownloadCommand}" ToolTip="下载选中远程项 (Ctrl+D)"/>
                <Button Content="↑ 上传" Command="{Binding LocalPane.UploadCommand}" ToolTip="上传选中本地项 (Ctrl+U)"/>
                <Separator/>
                <ToggleButton Content="显示隐藏" IsChecked="{Binding ShowHidden}" ToolTip="显示/隐藏隐藏文件"/>
                <Separator/>
                <Button Content="关于" Command="{Binding AboutCommand}" ToolTip="关于 WinLinScp"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 双栏 -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <views:FilePaneView Grid.Column="0" DataContext="{Binding LocalPane}"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>
            <views:FilePaneView Grid.Column="2" DataContext="{Binding RemotePane}"/>
        </Grid>

        <!-- 任务队列：独立下侧栏（标题栏常驻，卡片区可收起 + 可拖高，不遮挡文件区） -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="6,2">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding TransferQueue.PanelVisible}" Margin="6,0,0,0" Padding="6,1"
                                  ToolTip="展开/收起任务详情">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="▾"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="▸"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button DockPanel.Dock="Right" Content="清理" Margin="0,0,6,0" Padding="8,1"
                            Command="{Binding TransferQueue.ClearFinishedCommand}"/>
                    <Button DockPanel.Dock="Right" Content="取消全部" Margin="0,0,6,0" Padding="8,1"
                            Command="{Binding TransferQueue.CancelAllCommand}"/>
                    <TextBlock Text="任务队列" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TransferQueue.TotalText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    <TextBlock Text="{Binding TransferQueue.ActivityText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="#0078D4" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- 卡片区：可拖高（顶部拖拽条）+ 可收起 -->
            <Grid Grid.Row="1" Visibility="{Binding TransferQueue.PanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding TransferQueue.TaskPanelHeight, Converter={StaticResource DblToLen}}" MinHeight="40"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="6" Background="#DDDDDD" Cursor="SizeNS"
                        ToolTip="拖动调整任务区高度"
                        PreviewMouseLeftButtonDown="TaskResize_MouseDown"
                        PreviewMouseMove="TaskResize_MouseMove"
                        PreviewMouseLeftButtonUp="TaskResize_MouseUp"/>
                <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                    <ListBox ItemsSource="{Binding TransferQueue.Items}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Margin="4,3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontSize="11"
                                                   Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Height="4" Margin="0,4,0,2" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="取消" Padding="8,0" FontSize="10"
                                                Command="{Binding DataContext.TransferQueue.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding TargetText}" FontSize="10" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding EtaText}" FontSize="10"
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectedText}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="WinLinScp · 轻量文件管理"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
